<!--
 Target job for StaleExecutionsSETest. It has its own job name, separate from
 org.jberet.se.test.adminOpsFail, so that two test classes sharing the H2 job repository cannot
 see each other's executions, and separate from batchlet1 and friends, whose job instances
 JobDataTest asserts against.
-->
<job id="org.jberet.se.test.adminOps" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/jobXML_1_0.xsd"
     version="1.0">
    <step id="adminOpsStep">
        <batchlet ref="adminOpsTargetBatchlet">
            <properties>
                <property name="block" value="#{jobParameters['block']}?:false;"/>
            </properties>
        </batchlet>
    </step>
</job>
